{
  "name": "wecom-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge WeCom and Feishu conversations to Codex App Server.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["adapters/*"],
  "scripts": {
    "adapters:build": "pnpm --recursive --filter './adapters/*' build",
    "adapters:typecheck": "pnpm --recursive --filter './adapters/*' typecheck",
    "build": "cargo build --workspace && pnpm adapters:build",
    "test": "cargo test --workspace",
    "typecheck": "cargo check --workspace && pnpm adapters:typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.14.0"
}
